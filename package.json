{
  "name": "tinyhouse",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "pnpm --filter tinyhouse-server start",
    "dev:client": "pnpm --filter client dev",
    "lint": "pnpm --filter tinyhouse-server lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build"
  }
}
